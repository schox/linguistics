filters:
  and:
    - type == "Script"
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Scripts
    order:
      - formula.title
      - class
      - decipherment_status
      - period
      - corpus_size
      - iso15924
    sort:
      - property: decipherment_status
        direction: ASC
  - type: table
    name: Undeciphered scripts
    filters:
      and:
        - decipherment_status != "deciphered"
    order:
      - formula.title
      - class
      - decipherment_status
      - period
      - corpus_size
    sort:
      - property: period
        direction: ASC
