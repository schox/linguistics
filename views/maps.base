filters:
  and:
    - type == "MOC"
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Maps (area and subfield hubs)
    order:
      - formula.title
      - area
      - subfield
      - updated
    sort:
      - property: area
        direction: ASC
      - property: file.name
        direction: ASC
