filters:
  and:
    - type == "Language"
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Languages
    order:
      - formula.title
      - family
      - branch
      - era
      - status
      - glottocode
    sort:
      - property: family
        direction: ASC
