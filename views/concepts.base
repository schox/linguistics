filters:
  and:
    - 'type == "Concept"'
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Concepts
    order:
      - formula.title
      - subfield
      - status
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
