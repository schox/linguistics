filters:
  and:
    - type == "ComputerLanguage"
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Computer Languages
    order:
      - formula.title
      - paradigm
      - first_appeared
      - lineage
      - status
    sort:
      - property: paradigm
        direction: ASC
