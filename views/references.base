filters:
  and:
    - 'type == "Reference"'
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Citation
views:
  - type: table
    name: Bibliography
    order:
      - formula.title
      - authors
      - year
      - title
      - ref_type
      - status
    sort:
      - property: authors
        direction: ASC
  - type: table
    name: Sources by year
    order:
      - formula.title
      - year
      - authors
      - title
      - ref_type
    sort:
      - property: year
        direction: DESC
  - type: table
    name: Reading list (unread)
    filters:
      and:
        - 'status == "unread"'
    order:
      - formula.title
      - authors
      - year
      - title
      - ref_type
    sort:
      - property: year
        direction: DESC
