filters:
  and:
    - 'type == "Method"'
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Methods
    order:
      - formula.title
      - category
      - subfield
      - status
    sort:
      - property: category
        direction: ASC
