filters:
  and:
    - 'type == "Place"'
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Places
    order:
      - formula.title
      - kind
      - region
      - flourished
    sort:
      - property: kind
        direction: ASC
  - type: table
    name: Sites (provenance)
    filters:
      and:
        - 'kind == "site"'
    order:
      - formula.title
      - region
      - flourished
    sort:
      - property: flourished
        direction: ASC
