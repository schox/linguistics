filters:
  and:
    - type == "Cipher"
formulas:
  title: file.asLink(aliases[0])
properties:
  formula.title:
    displayName: Title
views:
  - type: table
    name: Ciphers
    order:
      - formula.title
      - category
      - era
      - status
    sort:
      - property: era
        direction: ASC
