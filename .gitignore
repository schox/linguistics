# Obsidian per-machine state. The settings files (app, appearance, graph,
# types, and the enabled-plugin lists) are committed so every machine gets
# the same vault behavior.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Plugin code is not committed: 2.6 MB of bundled JavaScript that changes
# with every plugin update, against 24 KB of settings. community-plugins.json
# records which plugins to install; the app fetches them.
.obsidian/plugins/

# Python
__pycache__/
*.pyc

# Claude Code per-machine permissions. .claude/settings.json IS committed:
# it carries the permissions every environment needs to work on this vault.
.claude/settings.local.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Editors
.vscode/
.idea/
*.swp
*.swo
